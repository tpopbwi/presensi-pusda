    }
}

/* =========================================
   ✅ PRINT STYLES
   ========================================= */
@media print {
    .sidebar,
    .bottom-nav,
    .page-header,
    .success-toast,
    .btn-load-more,
    .filter-controls,
    #notificationModal {
        display: none !important;
    }
    
    .main-content {
        margin-left: 0 !important;
        width: 100% !important;
        max-width: 100% !important;
        padding: 0 !important;
    }
    
    .raport-card {
        break-inside: avoid;
        box-shadow: none !important;
        border: 1px solid #ddd !important;
        background: #fff !important;
    }
    
    body {
        background: #fff !important;
        color: #000 !important;
    }
}

